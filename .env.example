NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<encoded-password>@<cluster-host>/resq?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required only when running npm run seed or npm run seed:admin.
# Use a unique admin password of at least 16 characters; other seed passwords must be at least 12.
DEMO_ADMIN_EMAIL=admin@gmail.com
DEMO_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
DEMO_OPERATOR_EMAIL=operator@resq.local
DEMO_OPERATOR_PASSWORD=replace-with-a-unique-long-operator-password
DEMO_DRIVER_EMAIL=driver@resq.local
DEMO_DRIVER_PASSWORD=replace-with-a-unique-long-driver-password
DEMO_USER_EMAIL=user@resq.local
DEMO_USER_PASSWORD=replace-with-a-unique-long-user-password
